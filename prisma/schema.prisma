generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journal_entries {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  mood_rating Int      @db.SmallInt
  entry_text  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_journal_user")
}

model lesson_steps {
  id            Int              @id @default(autoincrement())
  lesson_id     Int
  step_type     lesson_step_type
  content       Json
  order         Int              @db.SmallInt
  lessons       lessons          @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_progress user_progress[]
}

model lessons {
  id           Int            @id @default(autoincrement())
  module_id    Int
  title        String
  order        Int            @db.SmallInt
  lesson_steps lesson_steps[]
  modules      modules        @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model modules {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  type        module_type
  lessons     lessons[]
}

model user_progress {
  user_id        String       @db.Uuid
  lesson_step_id Int
  completed_at   DateTime     @default(now()) @db.Timestamptz(6)
  lesson_steps   lesson_steps @relation(fields: [lesson_step_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_progress_lesson_step")
  users          users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_progress_user")

  @@id([user_id, lesson_step_id])
}

model users {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String            @unique
  password_hash   String
  name            String?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  role            user_role         @default(USER)
  journal_entries journal_entries[]
  user_progress   user_progress[]
}

enum lesson_step_type {
  INFO_CARD
  MULTIPLE_CHOICE
  GUIDED_PRACTICE
  TEXT_INPUT
}

enum module_type {
  FOR_USER
  FOR_SUPPORTER
}

enum user_role {
  USER
  ADMIN
}
